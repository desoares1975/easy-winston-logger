{
  "name": "easy-winston-logger",
  "version": "0.2.0",
  "description": "Logger for Node.js servers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "coverage": "npm run test | coveralls",
    "test": "jest --ci --collectCoverage --forceExit",
    "testdev": "nodemon --exec jest"
  },
  "author": "desoares1975",
  "repository": {
    "type": "git",
    "url": "git@github.com:desoares1975/easy-winston-logger.git"
  },
  "license": "MIT",
  "dependencies": {
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-mongodb": "^7.0.1"
  },
  "homepage": "https://github.com:desoares1975/easy-winston-logger.git#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.2"
  },
  "keywords": [
    "logger",
    "winston",
    "easy",
    "wrapper",
    "leveled",
    "logger"
  ],
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.spec.ts"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
